# ---------- aplikasi ----------
APP_NAME=daily-task
APP_PORT=3000
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# ---------- database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=daily_task
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# ---------- upload file ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
ALLOWED_EXT=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.zip

# ---------- dokumentasi API ----------
# Swagger UI di /swagger/index.html. Set false untuk mematikannya.
ENABLE_DOCS=true

# ---------- autentikasi ----------
# WAJIB diganti di luar development — siapa pun yang tahu nilai ini
# bisa membuat token atas nama user mana pun.
# Contoh membuat nilai acak: openssl rand -hex 32
JWT_SECRET=dev-secret-wajib-diganti-di-production
# Umur token. Format durasi Go: 30m, 24h, 168h
JWT_TTL=24h
# Batas percobaan di /auth/* per IP, untuk mencegah penebakan password
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m
