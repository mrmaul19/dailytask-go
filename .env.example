# ---------- aplikasi ----------
APP_NAME=daily-task
APP_PORT=3000
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# ---------- database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=daily_task
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# ---------- upload file ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
ALLOWED_EXT=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.zip

# ---------- dokumentasi API ----------
# Swagger UI di /swagger/index.html. Set false untuk mematikannya.
ENABLE_DOCS=true
